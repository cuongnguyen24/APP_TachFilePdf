<Window x:Class="TachFilePdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tách/Gộp File PDF"
        Width="1220"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F6">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#EF2329" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#D71920" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DDE2EA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="#F3F5F9"
                                BorderBrush="#E6EAF1"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="White" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ModeBorder" Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#7A8699" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.22*" MinWidth="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.78*" MinWidth="410" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PreviewToolbarPanel"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Trang hiện tại:" />
                            <Button Grid.Column="1"
                                    Width="32"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Content="‹"
                                    ToolTip="Trang trước"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PreviousPageButton_Click" />
                            <TextBox Grid.Column="2"
                                     x:Name="PreviewPageTextBox"
                                     Width="58"
                                     Height="30"
                                     Margin="8,0"
                                     Text="1"
                                     Style="{StaticResource TextInput}"
                                     TextAlignment="Center"
                                     LostFocus="PreviewPageTextBox_LostFocus"
                                     KeyDown="PreviewPageTextBox_KeyDown" />
                            <TextBlock Grid.Column="3"
                                       x:Name="PreviewTotalPagesTextBlock"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="/ 0" />
                            <Button Grid.Column="4"
                                    Width="32"
                                    Height="30"
                                    Margin="8,0,0,0"
                                    Content="›"
                                    ToolTip="Trang sau"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="NextPageButton_Click" />
                            <TextBlock Grid.Column="5"
                                       Margin="18,0,8,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Zoom:" />
                            <Button Grid.Column="6"
                                    Width="32"
                                    Height="30"
                                    Content="−"
                                    ToolTip="Thu nhỏ"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ZoomOutButton_Click" />
                            <TextBlock Grid.Column="7"
                                       x:Name="PreviewZoomTextBlock"
                                       Width="50"
                                       Margin="8,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="100%" />
                            <Button Grid.Column="8"
                                    Width="32"
                                    Height="30"
                                    Content="+"
                                    ToolTip="Phóng to"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ZoomInButton_Click" />
                            <Button Grid.Column="9"
                                    MinWidth="76"
                                    Height="30"
                                    Margin="8,0,0,0"
                                    Content="Vừa khung"
                                    ToolTip="Thu/phóng để vừa bề rộng khung xem"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="FitWidthButton_Click" />
                            <Button x:Name="PreviewLayoutButton"
                                    Grid.Column="11"
                                    MinWidth="122"
                                    Height="30"
                                    Content="Đổi hiển thị"
                                    ToolTip="Đổi giữa xem dọc, lưới nhiều trang và chế độ chọn/copy text"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PreviewLayoutButton_Click" />
                        </Grid>
                    </Border>

                    <Grid x:Name="PreviewHostGrid" Grid.Row="1">
                        <ScrollViewer x:Name="PdfPagesScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      SizeChanged="PdfPagesScrollViewer_SizeChanged"
                                      ScrollChanged="PdfPagesScrollViewer_ScrollChanged">
                            <ItemsControl x:Name="PdfPagesItemsControl">
                                <ItemsControl.LayoutTransform>
                                    <ScaleTransform x:Name="PdfPreviewScaleTransform" ScaleX="1" ScaleY="1" />
                                </ItemsControl.LayoutTransform>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="18,18,18,0"
                                                Padding="8"
                                                Background="White"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                MouseLeftButtonDown="PreviewPageCard_MouseLeftButtonDown">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Chỉnh sửa">
                                                        <MenuItem Header="Xoay trái 90°" Click="RotatePageLeftMenuItem_Click" />
                                                        <MenuItem Header="Xoay phải 90°" Click="RotatePageRightMenuItem_Click" />
                                                        <MenuItem Header="Kiểm tra DPI" Click="CheckPageDpiMenuItem_Click" />
                                                        <MenuItem Header="Kiểm tra chuẩn PDF/A/PDF" Click="CheckPdfStandardMenuItem_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Xóa trang" Click="DeletePageMenuItem_Click" />
                                                        <MenuItem Header="Nhân bản trang" Click="DuplicatePageMenuItem_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Chuyển lên trước" Click="MovePagePreviousMenuItem_Click" />
                                                        <MenuItem Header="Chuyển xuống sau" Click="MovePageNextMenuItem_Click" />
                                                        <MenuItem Header="Đưa lên đầu" Click="MovePageFirstMenuItem_Click" />
                                                        <MenuItem Header="Đưa xuống cuối" Click="MovePageLastMenuItem_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Hoàn tác chỉnh sửa file này" Click="ResetPdfEditsMenuItem_Click" />
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PageLabel}"
                                                           Margin="0,0,0,8"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A" />
                                                <Image Source="{Binding Image}"
                                                       Stretch="None"
                                                       HorizontalAlignment="Center"
                                                       ToolTipService.IsEnabled="{Binding ShowHoverPreview}">
                                                    <Image.ToolTip>
                                                        <ToolTip Placement="Mouse"
                                                                 Background="White"
                                                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                                                 BorderThickness="1"
                                                                 Padding="10">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding PageLabel}"
                                                                           Margin="0,0,0,8"
                                                                           HorizontalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#0F172A" />
                                                                <Image Source="{Binding Image}"
                                                                       Width="620"
                                                                       MaxHeight="760"
                                                                       Stretch="Uniform" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Image.ToolTip>
                                                </Image>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <wv2:WebView2 x:Name="TextSelectionPdfWebView"
                                      Visibility="Collapsed" />
                        <Canvas x:Name="CropOverlayCanvas"
                                Background="#01000000"
                                Visibility="Collapsed"
                                MouseRightButtonDown="CropOverlayCanvas_MouseRightButtonDown"
                                MouseMove="CropOverlayCanvas_MouseMove"
                                MouseRightButtonUp="CropOverlayCanvas_MouseRightButtonUp">
                            <Rectangle x:Name="CropSelectionRectangle"
                                       Visibility="Collapsed"
                                       Stroke="#EF2329"
                                       StrokeThickness="2"
                                       Fill="#33EF2329" />
                        </Canvas>
                        <Canvas x:Name="EditOverlayCanvas"
                                Background="#01000000"
                                Visibility="Collapsed"
                                MouseLeftButtonDown="EditOverlayCanvas_MouseLeftButtonDown"
                                MouseMove="EditOverlayCanvas_MouseMove"
                                MouseLeftButtonUp="EditOverlayCanvas_MouseLeftButtonUp">
                            <Rectangle x:Name="EditSelectionRectangle"
                                       Visibility="Collapsed"
                                       Stroke="#0F172A"
                                       StrokeThickness="2"
                                       StrokeDashArray="4 2"
                                       Fill="#44EF2329" />
                        </Canvas>
                        <StackPanel x:Name="PreviewPlaceholderPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="280">
                            <Image Source="Assets/pdf-logo.png"
                                   Width="96"
                                   Height="96"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14" />
                            <TextBlock Text="Chọn PDF để xem trước"
                                       TextAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <TextBlock Text="Preview dùng cho thao tác tách file và chỉnh sửa nhanh từng trang."
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Border x:Name="PreviewDisabledOverlay"
                                Background="#EEF1F6"
                                Opacity="0.92"
                                Visibility="Collapsed"
                                IsHitTestVisible="True">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="300">
                                <Image Source="Assets/pdf-logo.png"
                                       Width="76"
                                       Height="76"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"
                                       Opacity="0.45" />
                                <TextBlock Text="Preview đang tạm ẩn"
                                           TextAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B" />
                                <TextBlock Text="Quay lại tab Tách file để xem và chỉnh sửa PDF đầu vào."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="#94A3B8" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="DocumentPickerPanel"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
                            <Image Source="Assets/pdf-logo.png" Width="30" Height="30" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="Tách/Gộp File PDF" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock x:Name="DocumentInfoTextBlock"
                                           Text="Chưa chọn PDF"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputFileTextBox" IsReadOnly="True" Style="{StaticResource TextInput}" />
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Content="Chọn PDF"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ChoosePdfButton_Click" />
                            <TextBox Grid.Row="2"
                                     x:Name="OutputFolderTextBox"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextInput}" />
                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Content="Chọn thư mục"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ChooseOutputFolderButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TabControl x:Name="MainActionTabControl"
                                SelectionChanged="MainActionTabControl_SelectionChanged">
                        <TabItem x:Name="SplitTabItem" Header="Tách file">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18">
                                    <TextBlock Text="Chế độ khoảng" FontWeight="SemiBold" />
                                    <Grid Margin="0,10,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="CustomModeRadio"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModeButton}"
                                                     IsChecked="True"
                                                     Checked="ModeRadio_Checked">
                                            <TextBlock Text="Tùy chỉnh" TextAlignment="Center" />
                                        </RadioButton>
                                        <RadioButton x:Name="FixedModeRadio"
                                                     Grid.Column="1"
                                                     Style="{StaticResource ModeButton}"
                                                     Checked="ModeRadio_Checked">
                                            <TextBlock Text="Cố định" TextAlignment="Center" />
                                        </RadioButton>
                                    </Grid>

                                    <StackPanel x:Name="CustomRangesPanel">
                                        <ItemsControl x:Name="RangesItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="42" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding FromPage, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource TextInput}" />
                                                        <TextBox Grid.Column="3"
                                                                 Text="{Binding ToPage, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource TextInput}" />
                                                        <Button Grid.Column="4"
                                                                Height="36"
                                                                Margin="8,0,0,0"
                                                                Content="X"
                                                                ToolTip="Xóa khoảng"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="RemoveRangeButton_Click" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Width="150"
                                                HorizontalAlignment="Left"
                                                Content="+  Thêm khoảng"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="AddRangeButton_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="FixedPanel" Visibility="Collapsed">
                                        <TextBlock Text="Mỗi file mới gồm số trang" FontWeight="SemiBold" />
                                        <TextBox x:Name="FixedPageCountTextBox"
                                                 Width="150"
                                                 Margin="0,8,0,0"
                                                 HorizontalAlignment="Left"
                                                 Text="1"
                                                 Style="{StaticResource TextInput}" />
                                    </StackPanel>

                                    <CheckBox x:Name="UseCropWhenSplitCheckBox"
                                              Margin="0,18,0,0"
                                              Content="Áp dụng vùng crop hiện tại khi tách file"
                                              Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="CropTabItem" Header="Crop PDF" Visibility="Collapsed">
                            <StackPanel Margin="18">
                                <TextBlock Text="Giữ chuột phải và kéo trên khung xem trước để chọn vùng cần giữ lại."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />

                                <Border Margin="0,14,0,0"
                                        Padding="12"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Vùng crop" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CropSelectionInfoTextBlock"
                                                   Margin="0,6,0,0"
                                                   Text="Chưa chọn vùng"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <CheckBox x:Name="ApplyCropAllPagesCheckBox"
                                          Margin="0,16,0,0"
                                          Content="Áp dụng cho tất cả các trang"
                                          IsChecked="True"
                                          Checked="ApplyCropScopeChanged"
                                          Unchecked="ApplyCropScopeChanged" />

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Trang áp dụng" FontWeight="SemiBold" />
                                    <TextBox x:Name="CropPageTextBox"
                                             Width="130"
                                             Margin="0,7,0,0"
                                             HorizontalAlignment="Left"
                                             Text="1"
                                             Style="{StaticResource TextInput}" />
                                </StackPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Xóa vùng chọn"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="ClearCropSelectionButton_Click" />
                                    <Button Grid.Column="2"
                                            Content="Lưu PDF đã crop"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="CropPdfButton_Click" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <TabItem x:Name="EditTabItem" Header="Chỉnh sửa">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18">
                                    <TextBlock Text="Bù viền / bù màu"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Kéo chuột trái trên preview để phủ màu lên vùng scan bị đen, viền lem hoặc nền cần tô lại."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />

                                    <Border Margin="0,14,0,0"
                                            Padding="12"
                                            Background="#F8FAFC"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="CoverColorPreviewBorder"
                                                    Width="42"
                                                    Height="42"
                                                    CornerRadius="21"
                                                    Background="#FFF7E9"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Màu phủ" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CoverColorTextBlock"
                                                           Margin="0,4,0,0"
                                                           Text="#FFF7E9"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Chọn màu"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="ChooseCoverColorButton_Click" />
                                                <Button Grid.Column="2"
                                                        Content="Bút lấy màu"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="PickCoverColorButton_Click" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Độ đậm màu" FontWeight="SemiBold" />
                                            <Slider x:Name="CoverOpacitySlider"
                                                    Margin="0,8,0,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="100"
                                                    TickFrequency="5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Áp dụng" FontWeight="SemiBold" />
                                            <CheckBox x:Name="ApplyCoverAllPagesCheckBox"
                                                      Margin="0,10,0,0"
                                                      Content="Cho tất cả trang" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,14,0,0"
                                            Padding="12"
                                            Background="#F8FAFC"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="Các vùng đã thêm" FontWeight="SemiBold" />
                                            <TextBlock x:Name="CoverAreasInfoTextBlock"
                                                       Margin="0,6,0,0"
                                                       Text="Chưa có vùng bù màu"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Hoàn tác vùng cuối"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="UndoCoverAreaButton_Click" />
                                        <Button Grid.Column="2"
                                                Content="Xóa tất cả vùng"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="ClearCoverAreasButton_Click" />
                                    </Grid>

                                    <TextBlock Margin="0,14,0,0"
                                               Text="Dùng nút Lưu PDF đã bù màu ở thanh dưới để xuất file."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="MergeTabItem" Header="Gộp PDF">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18">
                                    <TextBlock Text="Danh sách file cần gộp" FontWeight="SemiBold" />
                                    <TextBlock Text="Thứ tự trong danh sách là thứ tự xuất hiện trong file PDF sau khi gộp."
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />

                                    <Grid Margin="0,12,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="+  Thêm PDF"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="AddMergeFilesButton_Click" />
                                        <Button Grid.Column="2"
                                                Content="Xóa danh sách"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="ClearMergeFilesButton_Click" />
                                    </Grid>

                                    <Border Background="#F8FAFC"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <ListBox x:Name="MergeFilesListBox"
                                                 MinHeight="180"
                                                 MaxHeight="260"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 SelectionMode="Single"
                                                 SelectionChanged="MergeFilesListBox_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="26"
                                                                Height="26"
                                                                CornerRadius="13"
                                                                Background="#FEE2E2">
                                                            <TextBlock Text="{Binding Index}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#B91C1C" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#0F172A"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Margin="0,3,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <Grid Margin="0,10,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Lên"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="MoveMergeFileUpButton_Click" />
                                        <Button Grid.Column="2"
                                                Content="Xuống"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="MoveMergeFileDownButton_Click" />
                                        <Button Grid.Column="4"
                                                Content="Xóa file"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="RemoveMergeFileButton_Click" />
                                    </Grid>

                                    <TextBlock Text="Tên file sau khi gộp" FontWeight="SemiBold" />
                                    <TextBox x:Name="MergeOutputNameTextBox"
                                             Margin="0,8,0,0"
                                             Text="PDF_da_gop.pdf"
                                             Style="{StaticResource TextInput}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE2EA" BorderThickness="0,1,0,0">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                           x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Sẵn sàng." />
                <Button x:Name="PrimaryActionButton"
                        Grid.Column="1"
                        MinWidth="150"
                        Content="Tách PDF"
                        Style="{StaticResource PrimaryButton}"
                        Click="PrimaryActionButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
